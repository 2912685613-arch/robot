<?xml version="1.0"?>
<launch>
  <!--
    GAZEBO_MODEL_PATH is a search path, not a list of models to spawn.  Keep it
    limited to directories that actually contain model folders.  The resource
    path is needed by the UUV worlds, whose materials are referenced as
    file://Media/...
  -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find gazebo_world)/models:$(find gazebo_world)/model_for_world:$(find uuv_gazebo_worlds)/models:/usr/share/gazebo-11/models"/>
  <env name="GAZEBO_RESOURCE_PATH"
       value="$(find gazebo_world):$(find uuv_gazebo_worlds):/usr/share/gazebo-11"/>

  <!-- Do not try to download missing models from the online database. -->
  <env name="GAZEBO_MODEL_DATABASE_URI" value=""/>

  <arg name="world_name" default="$(find gazebo_world)/worlds/gazebo.world"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="headless" value="$(arg headless)"/>
  </include>
</launch>

<?xml version="1.0"?>
<launch>

   <!-- robot and namespace xx -->
  <arg name="namespace" default="gazebo_eight_camera1"/>
  <arg name="robot" default="robot2"/>


    <!-- decision xx -->
  <node pkg="asrobot" type="decision_making1" name="decision_robot_eight1" launch-prefix="xterm -e" output="screen">
    <remap from="imu" to="$(arg namespace)/imu"/>
    <remap from="mc_message" to="$(arg robot)/mc_message"/>
    <remap from="pressure" to="$(arg namespace)/pressure"/>
    <remap from="camera8_message" to="$(arg robot)/camera8_message"/>
    <remap from="cmd_message" to="$(arg robot)/cmd_message"/>
  </node>

    <!-- joint_control xx -->
<node pkg="asrobot" type="joint_control" name="joint_control_eight2" output="screen">
 <remap from="pwm_message" to="$(arg robot)/pwm_message"/>
 <remap from="status_message" to="$(arg robot)/status_message"/>
 <remap from="joint1_position_controller/command" to="$(arg namespace)/joint1_position_controller/command"/>
 <remap from="joint2_position_controller/command" to="$(arg namespace)/joint2_position_controller/command"/>
 <remap from="joint3_position_controller/command" to="$(arg namespace)/joint3_position_controller/command"/>
 <remap from="joint4_position_controller/command" to="$(arg namespace)/joint4_position_controller/command"/>
 <remap from="joint5_position_controller/command" to="$(arg namespace)/joint5_position_controller/command"/>
 <remap from="joint6_position_controller/command" to="$(arg namespace)/joint6_position_controller/command"/>
 <remap from="joint7_position_controller/command" to="$(arg namespace)/joint7_position_controller/command"/>
 <remap from="joint8_position_controller/command" to="$(arg namespace)/joint8_position_controller/command"/>
 <remap from="joint9_position_controller/command" to="$(arg namespace)/joint9_position_controller/command"/>
<remap from="joint10_position_controller/command" to="$(arg namespace)/joint10_position_controller/command"/>
<remap from="joint11_position_controller/command" to="$(arg namespace)/joint11_position_controller/command"/>
<remap from="joint12_position_controller/command" to="$(arg namespace)/joint12_position_controller/command"/> 
  </node>

 <!--node pkg="asrobot" type="joint_control_trajectory" name="joint_control_trajectory" output="screen">
 <remap from="pwm_message" to="$(arg robot)/pwm_message"/>
 <remap from="status_message" to="$(arg robot)/status_message"/>
 <remap from="leg_controller/command" to="$(arg namespace)/leg_controller/command"/>
  </node-->
     <!-- thruster_control xx -->
<node pkg="asrobot" type="thruster_control_eight" name="thruster_control_eight2" output="screen">
<remap from="pwm_message" to="$(arg robot)/pwm_message"/>
    </node>


  <group ns="$(arg robot)">
    <node pkg="asrobot" type="motion" name="motion2" output="screen"/>
    <node pkg="asrobot" type="mancontrol" name="mancontrol2" launch-prefix="xterm -e" output="screen"/>
  </group>


<node pkg="asrobot" type="stereo_vision1_pub" name="stereo_vision1_pub" output="screen">
<remap from="camera2/image_raw2" to="$(arg namespace)/camera2/image_raw2"/>
<remap from="camera1/image_raw1" to="$(arg namespace)/camera1/image_raw1"/>
<remap from="camera8_message" to="$(arg robot)/camera8_message"/>
    </node>

<node pkg="asrobot" type="stereo_vision2_pub" name="stereo_vision2_pub" output="screen">
<remap from="camera4/image_raw4" to="$(arg namespace)/camera4/image_raw4"/>
<remap from="camera3/image_raw3" to="$(arg namespace)/camera3/image_raw3"/>
<remap from="camera8_message" to="$(arg robot)/camera8_message"/>
    </node>

<node pkg="asrobot" type="stereo_vision3_pub" name="stereo_vision3_pub" output="screen">
<remap from="camera6/image_raw6" to="$(arg namespace)/camera6/image_raw6"/>
<remap from="camera5/image_raw5" to="$(arg namespace)/camera5/image_raw5"/>
<remap from="camera8_message" to="$(arg robot)/camera8_message"/>
    </node>

<node pkg="asrobot" type="stereo_vision4_pub" name="stereo_vision4_pub" output="screen">
<remap from="camera8/image_raw8" to="$(arg namespace)/camera8/image_raw8"/>
<remap from="camera7/image_raw7" to="$(arg namespace)/camera7/image_raw7"/>
<remap from="camera8_message" to="$(arg robot)/camera8_message"/>
    </node>

<node pkg="asrobot" type="stereoVision_pub_eight1" name="stereoVision_pub_eight1" >
    </node>

</launch>

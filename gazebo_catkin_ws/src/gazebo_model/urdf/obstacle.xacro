<?xml version="1.0" ?>
<robot name="obstacle"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="move_box_link">

        <visual>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <geometry>
                <box size="1 1 1"/>
            </geometry>
        </visual>

        <inertial>
            <mass value="1e-5" />
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 0.0"/>
            <geometry>
                <box size="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="move_box_link">
        <material>Gazebo/Pedestrian</material>
        <!-- <static>true</static> -->
        <!-- float object -->
        <turnGravityOff>true</turnGravityOff>
    </gazebo>

    <!--gazebo>
        <plugin name="animate" filename="libmove_box.so">
         <animate_path>/home/guolab/catkin_ws/src/gazebo_ros_robot/gazebo_model/config/box_animate.yaml</animate_path>
        </plugin>
    </gazebo-->


</robot>

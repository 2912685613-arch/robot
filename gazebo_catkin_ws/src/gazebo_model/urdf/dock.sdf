<?xml version='1.0'?>
<sdf version='1.6'>
    <model name='dock'>

      <link name='dock_link'>
        <inertial>
          <mass>7.302</mass>
          <inertia>
            <ixx>0.19422</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.26943</iyy>
            <iyz>0.0057054</iyz>
            <izz>0.19708</izz>
          </inertia>
          <pose frame=''>-0.083172 -0.22007 0.32226 0 -0 0</pose>
        </inertial>
        <pose frame=''>-0 0 0 0 -0 0</pose>
        <gravity>1</gravity>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <enable_wind>0</enable_wind>
        <visual name='dock_visual'>
          <pose frame=''>0 0 0 0 -0 0</pose>
          <geometry>
            <mesh>
              <uri>/home/hcy/sw_ws/src/collector/meshes/dock.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <lighting>1</lighting>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <shader type='vertex'>
              <normal_map>__default__</normal_map>
            </shader>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
          <transparency>0</transparency>
          <cast_shadows>1</cast_shadows>
        </visual>
        <collision name='dock_collision'>
          <laser_retro>0</laser_retro>
          <max_contacts>10</max_contacts>
          <pose frame=''>0 0 0 0 -0 0</pose>
          <geometry>
            <mesh>
              <uri>/home/hcy/sw_ws/src/collector/meshes/dock.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
                <fdir1>0 0 0</fdir1>
                <slip1>0</slip1>
                <slip2>0</slip2>
              </ode>
              <torsional>
                <coefficient>1</coefficient>
                <patch_radius>0</patch_radius>
                <surface_radius>0</surface_radius>
                <use_patch_radius>1</use_patch_radius>
                <ode>
                  <slip>0</slip>
                </ode>
              </torsional>
            </friction>
            <bounce>
              <restitution_coefficient>0</restitution_coefficient>
              <threshold>1e+06</threshold>
            </bounce>
            <contact>
              <collide_without_contact>0</collide_without_contact>
              <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
              <collide_bitmask>1</collide_bitmask>
              <ode>
                <soft_cfm>0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e+13</kp>
                <kd>1</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0</min_depth>
              </ode>
              <bullet>
                <split_impulse>1</split_impulse>
                <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
                <soft_cfm>0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e+13</kp>
                <kd>1</kd>
              </bullet>
            </contact>
          </surface>
        </collision>

      </link>

      <static>0</static>
      <allow_auto_disable>1</allow_auto_disable>



      <link name='light_source1'>
        <pose>0.191830 0.003 0.242539 0 0 0</pose>

        <light name='led1' type='spot'>
          <pose>0 0 0 1.57 0 0</pose>
          <attenuation>
            <constant>-3</constant>
            <range>30</range>
            <linear>0.05</linear>
          </attenuation>
          <diffuse>0 1 0 1</diffuse>
          <specular>0 1 0 1</specular>
          <spot>
            <inner_angle>0.3</inner_angle>
            <outer_angle>0.35</outer_angle>
            <falloff>1</falloff>
          </spot>
          <direction>0 0 -1</direction>
        </light>

        <visual name='led1'>
          <geometry>
            <sphere>
              <!-- <radius>0.0057</radius> -->
              <radius>0.01</radius>
            </sphere>
          </geometry>
          <transparency>0.4</transparency>
          <material>
            <!-- <ambient>0.5 1 1 1</ambient>

  <!-- =========================================================
       (F) 下视相机（你文件已有，完整保留）
       ========================================================= -->
  <joint name="${namespace}/camera_bottom_joint" type="fixed">
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/camera_bottom_link"/>
  </joint>

  <link name="${namespace}/camera_bottom_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.005" radius="0.01575" /></geometry>
      <material name="red"><color rgba="0.792 0.820 0.933 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder length="0.005" radius="0.01575" /></geometry></collision>
    <inertial>
      <mass value="1e-5"/><origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <gazebo reference="${namespace}/camera_bottom_link">
    <sensor type="camera" name="camera_bottom_sensor">
      <update_rate>30.0</update_rate>
      <camera name="camera_bottom">
        <pose>0 0 0 0 1.5708 0</pose>
        <horizontal_fov>1.5708</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>100</far></clip>
      </camera>
      <plugin name="${namespace}_camera_bottom_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>${namespace}/camera_bottom</cameraName>
        <imageTopicName>camera_bottom/image_raw</imageTopicName>
        <cameraInfoTopicName>camera_bottom/camera_info</cameraInfoTopicName>
        <frameName>${namespace}/camera_bottom_link</frameName>
        <hackBaseline>0.0</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 双目相机、IMU、压力传感器（使用内联宏实例） -->
  <uuv:default_stereo_camera namespace="${namespace}"/>
  <uuv:default_imu namespace="${namespace}"/>
  <uuv:default_pressure namespace="${namespace}" parent_link="${namespace}/base_link">
    <origin xyz="-0.030 -0.030 0.172" rpy="0 0 0"/>
  </uuv:default_pressure>

  <!-- =========================================================
       (G) gazebo_ros_control（保持原配置）
       ========================================================= -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <legacyModeNS>true</legacyModeNS>
      <robotNamespace>/${namespace}</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
    </plugin>
  </gazebo>


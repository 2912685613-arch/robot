<?xml version="1.0"?>

<robot 
name="$(arg namespace)"
xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Input debug flag -->
  <xacro:arg name="debug" default="0"/>

  <!-- Vehicle's namespace -->
<xacro:property name="namespace" value="$(arg namespace)"/>

  <!-- Vehicle's color (Orange, Red, RedBright)-->
<xacro:property name="color" value="$(arg color)"/>

 <!-- Import all Gazebo-customization elements -->
<xacro:include filename="$(find gazebo_model)/urdf/gazebo_interface.xacro" />
<xacro:include filename="$(find gazebo_model)/urdf/gazebo_property.xacro" /> 
  <!-- Loading file with uuv sensors macros -->
<xacro:include filename="$(find uuv_sensor_ros_plugins)/urdf/sensor_snippets.xacro"/>
  <!--  the sensor modules include pressure sensor,add sensors that you want-->
<xacro:include filename="$(find gazebo_model)/urdf/gazebo_sensors.xacro"/>
  <!--  Loading file with the thruster setting-->
<xacro:include filename="$(find gazebo_model)/urdf/gazebo_thruster.xacro"/>

<material name="red">
  <color rgba="1 0 0 1"/>
</material>
<material name="green">
  <color rgba="0 1 0 1"/>
</material>

<!-- Load asrobot -->




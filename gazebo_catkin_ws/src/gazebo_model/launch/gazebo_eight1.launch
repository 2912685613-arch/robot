<?xml version="1.0"?>
<launch>
 <!-- Debug flag -->
  <arg name="debug" default="0"/>

  <!-- Vehicle's initial pose -->
  <arg name="x"     default="0"/>
  <arg name="y"     default="0"/>
  <arg name="z"     default="0"/><!--water depth 1.5m-->
  <arg name="roll"  default="0"/>
  <arg name="pitch" default="0"/>
  <arg name="yaw"   default="0"/>

  <!-- Vehicle's namespace and mode -->
  <arg name="mode" default="land"/>
  <arg name="namespace" default="gazebo_eight_camera1"/>
  <arg name="world_frame" default="world"/>


    <param name="robot_description"
           command="$(find xacro)/xacro --inorder '$(find gazebo_model)/urdf/robot_eight1/gazebo_eight_camera1_$(arg mode).xacro'
          debug:=$(arg debug)
          namespace:=$(arg namespace)
          inertial_reference_frame:=world" />

    <!-- Run a python script to the send a service call to gazebo_ros to spawn a URDF robot -->
    <node name="urdf_spawner81" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
          args="-urdf -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg roll) -P $(arg pitch) -Y $(arg yaw) -model $(arg namespace) -param robot_description"/>

    <!-- Publish robot model xx for ROS -->
    <node name="robot_state_publisher81" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true" output="screen">
      <param name="robot_description" value="robot_description" />
      <param name="publish_frequency" value="5" />
    </node>


  <!-- Publish state and tf for in relation to the world frame -->
  <include file="$(find uuv_assistants)/launch/message_to_tf.launch">
    	<arg name="namespace" value="$(arg namespace)"/>
	<arg name="world_frame" value="world"/>
  </include>
</launch>

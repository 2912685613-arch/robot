<?xml version="1.0"?>
<launch>
  <!-- Debug flag -->
  <arg name="debug" default="0"/>

  <!-- Vehicle's initial pose -->
  <arg name="x"     default="0"/>
  <arg name="y"     default="0"/>
  <arg name="z"     default="0"/>
  <arg name="roll"  default="0"/>
  <arg name="pitch" default="0"/>
  <arg name="yaw"   default="0"/>

  <!-- Vehicle namespace and mode -->
  <arg name="mode" default="land"/>
  <arg name="namespace" default="gazebo_eight_camera1"/>
  <arg name="world_frame" default="world"/>

  <!-- Keep this robot description separate from every other robot. -->
  <param name="/$(arg namespace)/robot_description"
         command="$(find xacro)/xacro --inorder '$(find gazebo_model)/urdf/robot_eight1/gazebo_eight_camera1_$(arg mode).xacro'
                  debug:=$(arg debug)
                  namespace:=$(arg namespace)
                  inertial_reference_frame:=world" />

  <node name="$(arg namespace)_urdf_spawner"
        pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
        args="-urdf
              -x $(arg x) -y $(arg y) -z $(arg z)
              -R $(arg roll) -P $(arg pitch) -Y $(arg yaw)
              -model $(arg namespace)
              -robot_namespace /$(arg namespace)
              -param /$(arg namespace)/robot_description" />

  <!-- gazebo_eight1 has unqualified link/frame names in its URDF. -->
  <group ns="$(arg namespace)">
    <node name="robot_state_publisher"
          pkg="robot_state_publisher" type="robot_state_publisher"
          respawn="true" output="screen">
    <param name="robot_description"
           command="$(find xacro)/xacro --inorder '$(find gazebo_model)/urdf/robot_eight1/gazebo_eight_camera1_$(arg mode).xacro'
                    debug:=$(arg debug)
                    namespace:=$(arg namespace)
                    inertial_reference_frame:=world" />
    <param name="publish_frequency" value="20" />
    <param name="tf_prefix" value="" />
    <remap from="joint_states" to="/$(arg namespace)/joint_states" />
    </node>
  </group>

  <include file="$(find uuv_assistants)/launch/message_to_tf.launch">
    <arg name="namespace" value="$(arg namespace)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="child_frame_id" value="/$(arg namespace)/base_link"/>
  </include>
</launch>
